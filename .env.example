# ===== 后端基础 =====
# ── DB：音乐平台 **独立库**（ISSUE #72 决策 1，2026-10-11 用户确认）──
# 音乐平台与 FLOW 各库各主权，**不共享** DB。用户身份经 token 交换 + `user_links`
# 映射关联（窄桥），而非同库 JOIN。
# ⚠ 绝不要把本值指向 FLOW 的 `.gospel.db`（共享库结论已被 #72 推翻，
#   见 docs/MUSIC_PLATFORM_MIGRATION_2026-09-10.md 头部 supersede 指针）。
# 生产容器内建议落 /app/data/music.db（见 docker-compose.yml backend 段）。
DATABASE_URL=sqlite:///./app.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-please
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# ===== GAP-013 无状态分享链接（HMAC 签名 token）=====
# 独立签名密钥：轮换它只作废已发出的分享链接，不必把所有用户的登录态一起踢下线。
# 留空则回落 JWT_SECRET（不配也能用，但两者就共享轮换周期了）。
# ⚠️ 只从环境读，绝不提交进 git（仓库 Public，进 git 即永久泄露）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SHARE_SECRET=
CORS_ORIGINS=http://localhost:3000

# ===== 对象存储 / CDN（S3 兼容：腾讯云 COS / Cloudflare R2 / AWS S3 / MinIO）=====
# 未配置（endpoint/bucket/access_key/secret_key 任一为空）→ 全链路**优雅降级**：
# 播放/下载/FLOW 歌单直接用上游 audio_url（30 天会过期，但不报错、不 500）。
# 配齐后新曲自动回源到自有桶，主播放链路优先下发 CDN 链接。
# ⚠ 密钥只从环境读，**绝不提交进 git**（仓库 Public，进 git 即永久泄露）。
STORAGE_ENDPOINT=
STORAGE_REGION=ap-hongkong
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# CDN 加速域名（强烈建议配）：播放链接一律经它出口，如 https://cdn.example.com
# 不配则退化为 {endpoint}/{bucket}（能用，但无边缘加速且暴露源站地址）
STORAGE_PUBLIC_BASE=
# ---- GAP-019 归档 / 保留（详见 docs/CDN_ARCHIVE_RUNBOOK.md）----
# 生成完成即回源（新曲第一个响应就是 CDN 链接）
ENABLE_CDN_MIRROR_ON_GENERATE=true
# 默认存储类别（留空 = 桶默认）。⚠ 不要填 GLACIER 类：不支持直接 GET，会打断播放
STORAGE_CLASS=
# 归档阈值（天，<=0 = 关闭归档）
STORAGE_ARCHIVE_AFTER_DAYS=90
# 归档目标类别（低频；GLACIER 类会被 scripts/archive_cdn.py 拒绝）
STORAGE_CLASS_ARCHIVE=STANDARD_IA

# ===== 音乐供应商：Route A = suno =====
MUSIC_PROVIDER=suno
SUNO_API_BASE=https://open.suno.cn/api/v1
# 二选一：优先用 API Key；否则用邮箱密码换 token
SUNO_API_KEY=
SUNO_EMAIL=
SUNO_PASSWORD=
# 轮询参数（秒）
SONG_POLL_INTERVAL=8
SONG_POLL_TIMEOUT=240

# ===== Mureka（昆仑万维）商业 API：christian_worship 主引擎 =====
# 官方商户后台：https://platform.mureka.ai/ ；基址 https://api.mureka.ai/v1
# docker-compose 的 backend.environment 已引用 ${MUREKA_API_KEY:-}（见 D48 修复），
# 故本文件需提供该变量，否则容器内 MUREKA_API_KEY 为空（mureka 默认 disabled，不生效）。
MUREKA_API_KEY=
MUREKA_MODEL=mureka-9
MUREKA_MAX_CONCURRENT=1

# ===== MiniMax Music 3：Mureka 的**备选供应商评估**（仅评估，非生产默认引擎）=====
# 官方文档：https://platform.minimax.io/docs/api-reference/music-generation
# 端点：POST https://api.minimax.io/v1/music_generation（基址填到 /v1）
# ⚠️ 官方公告：免费音乐生成接口（music-3.0-free / music-2.6-free / music-cover-free）
#    自 2026-08-20 起停止服务；付费音乐生成接口自同日起不再面向新用户。
#    → 下面默认是 free 档，仅在你手上有「历史付费账号」时可用；常规评估请改用
#      MINIMAX_MUSIC_MODEL=music-3.0 并充值，或直接走开源权重自托管。
MINIMAX_API_KEY=
MINIMAX_API_BASE=https://api.minimax.io/v1
# 官方 model 枚举六选一：music-3.0（推荐）/ music-2.6 / music-cover /
# music-3.0-free / music-2.6-free / music-cover-free
# 默认给 music-3.0（RPM 120）；-free 三档官方已公告 2026-08-20 停止服务。
MINIMAX_MUSIC_MODEL=music-3.0
# 官方明示：music-3.0 / music-2.6 / music-cover 档 RPM=120，
# free 档（已停服）RPM=3。客户端限速按此值换算，别随意调大。
MINIMAX_MUSIC_RPM=120

# ===== 内容审核 =====
# ⚠️ 代码默认值是 False（config.py:48/51），未显式设置时曲目会自动过审、
#    审核过滤器永不触发(D33)。必须显式保留 true。
ENABLE_MODERATION=true

# ===== FLOW 共存联动（co-location） =====
# [D27/D30] 与 FLOW 服务共享的 server-to-server 内部密钥。
# ⚠️ 留空则 /api/auth/flow-exchange 直接返回 503（auth.py:177-178），
#    且 FLOW 侧的 IP 速率限制绕过不生效 → 共存服务会自我限流(60 RPM)。
#    **必须与 FLOW 侧 .env.production 的 FLOW_INTERNAL_TOKEN 取同一个值。**
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
FLOW_INTERNAL_TOKEN=

# ===== 计费 / 支付（GAP-004 真实支付基座）=====
# billing_mode: offline=允许 mock /api/auth/subscribe 与 manual 确认(开发·运维对账); live=仅真实 provider 流程, mock/subscribe 返回 410
# billing_provider: manual | stripe | kakao | naver | wechat | alipay | paypal
#   step-1: manual=全功能(无外部依赖, 可测可运营); stripe=webhook 验签已实现, checkout SDK 为 step-2 seam
#   paypal: 多币种订阅(Subscriptions API), 服务器侧回传验签(见 1.6)
# ⚠️ 生产环境务必 billing_mode=live 并配置真实 provider 密钥, 否则 mock/subscribe 仍是"免费直接升档"后门
BILLING_MODE=offline
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ⚠️ approve 型 PG(kakao/naver) 回跳必须指向账户页(/account), 否则 pg_token/paymentId 无法被前端回跳处理器接收 → 升档永远不发生.
#   kakao: approval_url = BILLING_RETURN_URL?provider=kakao&order_id=N, Kakao 再追加 &pg_token=XXX
#   naver: 前端在本页用 provider_params 调 oPay.open, 完成后跳回 returnUrl(同 landing) 并带回 paymentId
# 例: https://your-domain.com/account
BILLING_RETURN_URL=

# ===== KakaoPay（한국, KRW）=====
# 단건결제(ready → 사용자 인증 → approve). 승격은 approve 성공 응답이 근거(webhook 없음).
# 2026-09-04 공식 문서 실증(카카오페이 개발자센터):
#   · 구 카카오디벨로퍼스(kapi.kakao.com/v1/payment/*) 는 **종료됨** → 아래 공식값만 사용
#   · Host: https://open-api.kakaopay.com  (샌드박스/개발 호스트 없음)
#   · Path: /online/v1/payment/ready , /online/v1/payment/approve
#   · 인증: Authorization: SECRET_KEY ${SECRET_KEY}   바디: JSON(application/json)
#   · pg_token 은 카카오가 approval_url 뒤에 **query string** 으로 붙여 리다이렉트해 준다.
# KAKAO_PAY_AUTH_SCHEME: SECRET_KEY(공식/기본) | KakaoAK(레거시 ADMIN_KEY 호환용)
KAKAO_PAY_CID=
KAKAO_PAY_CREDENTIAL=
KAKAO_PAY_AUTH_SCHEME=SECRET_KEY
KAKAO_PAY_API_BASE=https://open-api.kakaopay.com
# ⚠️ 回跳 URL 需能带回 provider=kakao & order_id, 落库升档在 POST /api/billing/kakao/approve

# ===== NaverPay（한국, KRW）=====
# JS SDK handoff(create_checkout 只返回 provider_params) + 서버 승인(approve). 승격은 approve 성공이 근거(webhook 없음).
# 2026-09-04 공식 문서 실증(docs.pay.naver.com):
#   · SDK 스크립트(고정): https://nsp.pay.naver.com/sdk/js/naverpay.min.js
#   · 승인 API: POST https://{dev-pay|pay}.paygate.naver.com/naverpay-partner/naverpay/payments/v2.2/apply/payment
#     (NAVER_PAY_MODE=development → dev-pay, production → pay. 공식 호스트가 확정되었으므로
#      아래 APPLY_URL 을 비워도 된다. 파트너 계약상 별도 도메인을 쓸 때만 전체 URL 로 덮어쓸 것)
#   · returnUrl 회귀: 성공 ?resultCode=Success&paymentId=... / 실패 ?resultCode=...&resultMessage=...&reserveId=...
#   · 보안: 승인 응답의 body.detail.totalPayAmount 를 주문 금액과 대조 검증(불일치 시 승격 중단)
NAVER_PAY_CLIENT_ID=
NAVER_PAY_CHAIN_ID=
NAVER_PAY_SECRET_KEY=
NAVER_PAY_MODE=development
NAVER_PAY_APPLY_URL=

# ===== WeChat Pay v3（中国大陆, CNY）=====
# Native 下单(返回 code_url → 前端渲染二维码) + 异步回调验签/解密. 升档以 webhook 验签成功为依据.
# 私钥 PEM(应用)/ 公钥 PEM(验签)/ APIv3 密钥(回调 AES-256-GCM 解密, 必须 32 字节) 三者缺一不可.
# 支持 inline(PEM 内换行写成字面 \n) 或 *_path 指向文件(二者取其一, inline 优先).
#
# 2026-09-04 官方文档实证(均取 .md 原文):
#   · 下单 POST https://api.mch.weixin.qq.com/v3/pay/transactions/native
#     必填头 Authorization + Accept: application/json + Content-Type: application/json
#   · 待签名串 = f"{METHOD}\n{PATH}\n{ts}\n{nonce}\n{body}\n"(五行, 含末尾换行)
#   · 回调验签头: Wechatpay-Timestamp / Nonce / Signature / **Serial**
#     Serial 决定用哪把公钥验签: "微信支付公钥的序列号固定采用 PUB_KEY_ID_数字串 格式……
#     若请求头中的序列号不符合该格式, 则应使用平台证书进行验签"(native_notify.md 2.1)
#     → 用【微信支付公钥】时填下面的 PUB_KEY_ID; 用【平台证书】时留空.
#     (官方 sign_verify.md 2.2 把微信支付公钥标为【推荐】)
#   · 应答: 验签通过 → 200/204; 不通过 → 4xx/5xx(微信按 15s/15s/30s/3m… 共 15 次重投)
#   · 官方会发 WECHATPAY/SIGNTEST/ 前缀的假签名探测, 代码已按官方要求正常验签并拒答.
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_PUB_KEY_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com

# ===== Alipay（中国大陆, CNY）=====
# 电脑网站支付(跳转型, 无需服务端请求) + 异步通知验签. 升档以异步通知验签成功为依据.
# 应用私钥 PEM(签名)/ 支付宝公钥 PEM(验签) 二者缺一不可; 仅支持 RSA2(SHA256withRSA).
# timestamp 用北京时间(+08:00, 固定偏移, 不依赖容器 tzdata).
#
# ⚠️ 2026-09-04 修掉的致命缺陷(勿改回): 验签规则 rsaCheckV1 要 **同时剔除 sign 与 sign_type**。
#    官方文档 opendocs.alipay.com/open/02pa44「异步通知结果验签」第 1 条 + 官方 SDK
#    Java AlipaySignature.getSignCheckContentV1 / PHP AopClient.rsaCheckV1 三方一致。
#    只剔除 sign 会让真实通知(必带 sign_type=RSA2)100% 验签失败 → 用户付款后永不升档。
#    注意: 请求签名规则与此不同(只剔除 sign, sign_type 参与), 代码里是两套, 勿合并。
#    应答必须返回纯文本 success(官方响应值: fail=重试, success=不重试)。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_SIGN_TYPE=RSA2
# ⚠️ live 模式上线前: alembic upgrade head 必跑(含 e1f2a3b4c5d6 退款闭环所需 provider_customer_id 列);
#    webhook/notify 公网 HTTPS 回调地址(NOTIFY_URL)需可达, 否则支付成功永不升档.

# ===== PayPal（多币种订阅 · Subscriptions API）=====
# 与其他 PG 都不同: 回调**不是本地 HMAC**, 而是把回调原样**回传给 PayPal 服务器**由它核验
#   (POST /v1/notifications/verify-webhook-signature, 成功 = verification_status=SUCCESS).
# 官方实证全部取自 developer.paypal.com 的 .md 原文(2026-09-05, 非推测).
#
# 币种: 官方币种表(developer.paypal.com/reference/currency-codes)共 25 种, **不含 KRW**;
#   CNY/BRL/MYR 官方脚注"仅支持 in-country PayPal accounts". 本系统面向中国用户且主体不在
#   美国/香港本地账户范围 → 默认受理集合剔除 CNY/BRL/MYR(见 config.paypal_currencies).
#   HUF/JPY/TWD 为零小数位币种(无小数), 金额换算已特殊处理.
#
# 订阅 plan: 不在运行时建 plan(需先建 product 且 plan 与币种/价格强绑定). plan 由运维在
#   PayPal 后台建好后, 通过 PAYPAL_PLAN_IDS 映射 tier_key → plan_id(支持 "tier:CCY" 粒度).
#   官方: "Only one currency_code is allowed per subscription plan." → 多币种必须多 plan.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox=https://api-m.sandbox.paypal.com | live=https://api-m.paypal.com
PAYPAL_MODE=sandbox
# Developer Portal 里该 webhook 的 ID; 回调验签必传(缺失 → 503, 绝不放行未验签回调)
PAYPAL_WEBHOOK_ID=
# tier_key → plan_id 的 JSON 映射, 支持 "tier:CCY" 粒度(例: {"standard":"P-XXX","pro:USD":"P-YYY"})
PAYPAL_PLAN_IDS=
# 买家批准后回跳地址(留空则回退 BILLING_RETURN_URL)
PAYPAL_RETURN_URL=
# 受理币种集合(逗号分隔, 大写). 默认剔除 CNY/BRL/MYR(限本国账户), 不含官方未列的 KRW.
PAYPAL_CURRENCIES=AUD,CAD,CZK,DKK,EUR,GBP,HKD,HUF,ILS,JPY,MXN,NZD,NOK,PHP,PLN,SGD,SEK,CHF,THB,TWD,USD

# ===== 时区 =====
# [D29] 固定为 UTC，避免容器继承宿主机本地时区导致时间计算漂移
# （naive datetime 会被 Python 按系统本地时区解释；香港 +8 / 韩国 +9 不一致）。
TZ=UTC

# ===== GAP-003 OAuth 授权码登录（Google / Kakao / Naver）=====
# 与 GOOGLE_CLIENT_ID（GIS 的 ID 令牌直传腿 /api/auth/google）并存，互不影响。
# enabled 判定：client_id 非空即为启用（Kakao 例外，允许空 Secret，见下）。
#
# ⚠ 回跳地址必须与各 provider 控制台登记的 redirect URI **逐字一致**，
#   否则授权码换令牌会报 invalid_grant（最容易踩的坑：漏 / 多斜杠、http vs https）。
OAUTH_REDIRECT_BASE_URL=
# 可选：不配则按 OAUTH_REDIRECT_BASE_URL + /api/auth/oauth/{provider}/callback 推导
# 三家实际登记的回跳 URL 形如：
#   https://your-api.example.com/api/auth/oauth/google/callback
#   https://your-api.example.com/api/auth/oauth/kakao/callback
#   https://your-api.example.com/api/auth/oauth/naver/callback

# 成功/失败回前端的落点：成功 `?oauth=1`，失败 `?oauth=0&reason=...`
OAUTH_FRONTEND_REDIRECT_URL=/account
# state 票据（服务端签名短寿命 JWT）寿命，秒。够走完一次授权页往返即可。
OAUTH_STATE_EXPIRE_SECONDS=600
OAUTH_HTTP_TIMEOUT=10

# ---- Google（OIDC）----
# 复用上面的 GOOGLE_CLIENT_ID 作为授权码腿的 client_id
OAUTH_GOOGLE_CLIENT_SECRET=

# ---- Kakao ----
# ⚠ Client Secret 是**可选**安全增强（Kakao 后台可关闭）→ 允许留空。
#   留空时令牌端点只校验 client_id，这是官方支持的合法配置，后端不会判为「未启用」。
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
# 邮箱属「추가 동의항목」，需在 Kakao 后台申请 account_email 权限；
# 未开通时 userinfo 不返回 email → 后端落 {sub}@kakao.oauth.local（不占用真实地址）。

# ---- Naver ----
# 邮箱是否返回取决于后台「이메일」제공 동의항목设置；Naver 不回 email_verified 字段，
# 故 naver 登录的邮箱一概不做同邮箱合并（保守取未验证），落 {sub}@naver.oauth.local。
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
