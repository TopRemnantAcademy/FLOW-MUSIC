# ══════════════════════════════════════════════════════════════════════════
# FLOW CCM 음악 백엔드 환경변수 템플릿
#   복사: cp .env.music.example .env.music
#
# 🔴 아래 2개는 **비우면 배포 자체가 실패** 한다(docker-compose.yml 이 `:?` 지정):
#   · JWT_SECRET     — 미설정/공개 기본값이면 누구나 위조 JWT 생성(완전 인증 우회)
#   · MUREKA_API_KEY — 운영 음악 엔진 자격증명. 없으면 전 곡이 401 로 실패
#   발급: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ⚠ .env.music(실제)는 절대 커밋하지 않는다. 이 파일(.example)만 커밋.
# ══════════════════════════════════════════════════════════════════════════

JWT_SECRET=
MUREKA_API_KEY=

# ── Mureka 설정 ──
MUREKA_MODEL=mureka-9
MUREKA_N=1
# 구매 플랜 concurrency 와 맞출 것(미스매치 시 429)
MUREKA_MAX_CONCURRENT=1
MUREKA_API_BASE=https://api.mureka.ai/v1

# ── 데이터베이스 ──
# SQLite(컨테이너 내 /app/data → 호스트 ./music-data 바인드) — **현행 기본값, 유지**.
DATABASE_URL=sqlite:////app/data/app.db
# "1" = create_all 자동 생성(신규 SQLite 권장). Alembic 과 혼용 금지.
SCHEMA_CREATE_ALL=1

# ── PostgreSQL (음악 전용 독립库, Ref: #72 / #74) ──
# 前置: 배포기에 이미 컨테이너 flow-hk-music-postgres(postgres:16.15-alpine) 가
#       돌고 있고, 库/유저 = flow_music, 凭证在 .env.music-pg(이 파일에 베끼지 말 것).
#
# 전환 절차(3단계):
#   1) 아래 DATABASE_URL 을 실제 값으로 바꾼다(위 sqlite 줄은 주석 처리):
#        DATABASE_URL=postgresql+psycopg://flow_music:<.env.music-pg 의 비밀번호>@flow-hk-music-postgres:5432/flow_music
#      ※ 驱动 psycopg[binary] 는 이미 이미지에 들어 있다(2026-10-11) — 추가 설치 불필요.
#      ※ 컨테이너 이름으로 연결하려면 두 컨테이너가 같은 docker network 에 있어야 함.
#         아니면 127.0.0.1:5432 로 바꾸고 PG 를 호스트에 노출할 것.
#   2) SCHEMA_CREATE_ALL 을 정책적으로 고른다:
#        =1 → 기동 시 create_all 로 빈 库에 schema 생성(빠른 시작, 之后 alembic 금지)
#        =0 → 스키마는 `alembic upgrade head` 가 책임(권장. 버전 관리 가능)
#      ⚠ 둘을 같이 쓰면 create_all 이 먼저 表를 만들고 alembic 이 "already exists" 로 실패한다.
#      alembic 실행: docker compose exec backend alembic upgrade head
#                    (version_table=alembic_version_music → FLOW 와 버전 테이블 분리됨)
#   3) 回切: DATABASE_URL 을 sqlite 로 되돌리기만 하면 된다(코드 분기 불필요).
#
# 🔴 切库前必须先处理的事(实测, 2026-10-11):
#    PG 의 timestamptz 는 UTC 저장 + **세션 타임존으로 回读** → 回读된 时间은 aware.
#    반면 app/billing/service.py:_utcnow() 는 sqlite 에 맞춰 naive UTC 를 돌려준다.
#    둘을 비교하면 TypeError → get_current_user 가 500,
#    즉 **기존 구독자 전원의 모든 인증 요청이 죽는다**. sqlite 에서는 재현되지 않는다.
#    → 시각 비교의 tz 통일(별도 과제)을 먼저 끝낸 뒤에 이 전환을 집행할 것.
# DATABASE_URL=postgresql+psycopg://flow_music:<PASSWORD>@flow-hk-music-postgres:5432/flow_music

# ── CORS ──
CORS_ORIGINS=https://music.anistar.studio,capacitor://localhost,https://localhost

# ── Google OAuth (비우면 Google 로그인 비활성화) ──
# CCM Android/WebView 용 Google Client ID(Web application 타입).
# Google Cloud Console → authorized JavaScript origins 에
#   music.anistar.studio, capacitor://localhost, https://localhost  추가 필수.
# 콤마로 여러 ID 허용(백엔드가 토큰 aud 검증에 사용).
GOOGLE_CLIENT_ID=

# ── 기타 ──
MUSIC_PROVIDER=mureka
TZ=Asia/Seoul
LOG_LEVEL=INFO
