# ══════════════════════════════════════════════════════════════════════════
# FLOW CCM 음악 백엔드 환경변수 템플릿
#   복사: cp .env.music.example .env.music
#
# 🔴 아래 2개는 **비우면 배포 자체가 실패** 한다(docker-compose.yml 이 `:?` 지정):
#   · JWT_SECRET     — 미설정/공개 기본값이면 누구나 위조 JWT 생성(완전 인증 우회)
#   · MUREKA_API_KEY — 운영 음악 엔진 자격증명. 없으면 전 곡이 401 로 실패
#   발급: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ⚠ .env.music(실제)는 절대 커밋하지 않는다. 이 파일(.example)만 커밋.
# ══════════════════════════════════════════════════════════════════════════

JWT_SECRET=
MUREKA_API_KEY=

# ── Mureka 설정 ──
MUREKA_MODEL=mureka-9
MUREKA_N=1
# 구매 플랜 concurrency 와 맞출 것(미스매치 시 429)
MUREKA_MAX_CONCURRENT=1
MUREKA_API_BASE=https://api.mureka.ai/v1

# ── 데이터베이스 ──
# SQLite(컨테이너 내 /app/data → 호스트 ./music-data 바인드)
DATABASE_URL=sqlite:////app/data/app.db
# "1" = create_all 자동 생성(신규 SQLite 권장). Alembic 과 혼용 금지.
SCHEMA_CREATE_ALL=1

# ── CORS ──
CORS_ORIGINS=https://music.anistar.studio,capacitor://localhost,https://localhost

# ── Google OAuth (비우면 Google 로그인 비활성화) ──
# CCM Android/WebView 용 Google Client ID(Web application 타입).
# Google Cloud Console → authorized JavaScript origins 에
#   music.anistar.studio, capacitor://localhost, https://localhost  추가 필수.
# 콤마로 여러 ID 허용(백엔드가 토큰 aud 검증에 사용).
GOOGLE_CLIENT_ID=

# ── 기타 ──
MUSIC_PROVIDER=mureka
TZ=Asia/Seoul
LOG_LEVEL=INFO
