# =========================================================
# FLOW CCM 음악 백엔드 사이트 블록 (준비 완료, 기본 미적용)
# ─────────────────────────────────────────────────────────
# DNS 확인됨(2026-10-01): music.anistar.studio → 43.128.155.138
#
# ⚠ 적용 전제:
#   1) music 서비스가 실제로 떠 있어야 한다(compose --profile music).
#      안 떠 있으면 이 블록만 넣으면 502 가 되므로, **백엔드 기동과 세트로** 적용한다.
#   2) 적용 방법: 아래 블록을 deploy/hk/Caddyfile **끝에 추가** 한 뒤 caddy 재생성
#        docker compose -p flow-hk --env-file .env.hk up -d --force-recreate caddy
#
# 라우팅: FLOW 는 /api/payment/*, 음악은 /api/plaza·/api/songs 등을 쓰므로
#         서브도메인 분리 방식이라 경로 충돌이 없다(같은 도메인 혼용보다 안전).
# =========================================================

music.anistar.studio {
    log {
        output stdout
        level ERROR
    }

    header {
        -Server
        -X-Powered-By
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss: https:; frame-ancestors 'self'"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    encode zstd gzip

    handle {
        reverse_proxy music:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            transport http {
                read_timeout    5m
                write_timeout   5m
            }
        }
    }
}
