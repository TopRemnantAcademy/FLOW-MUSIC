# =========================================================
# FLOW(CCM) 生产环境 .env 模板 —— 复制为 .env.production 后填写
#
# ⛔ 部署脚本(flow/bootstrap.sh) 会做 fail-closed 检查：
#    LLM_PROVIDER 与对应 API Key 缺失时**拒绝部署**。
#    判读口径与后端 /ready 的 llm:key_missing 一致。
#
# 完整变量见 FLOW 仓库根 .env.example；此处仅列部署必填/关键项。
# =========================================================

# ── 1. LLM（硬阻塞项）──────────────────────────────────────
# 支持：gemini / openai / anthropic / deepseek / tencent / ollama
LLM_PROVIDER=gemini

# 对应 provider 的 key（按 LLM_PROVIDER 填**至少**下面一个）：
GOOGLE_API_KEY=            # gemini
DEEPSEEK_API_KEY=          # deepseek
OPENAI_API_KEY=            # openai
ANTHROPIC_API_KEY=         # anthropic(claude)
TENCENT_API_KEY=           # tencent
OLLAMA_HOST=               # ollama（本地，无需 key）

# 主 provider 失败时的兜底（true 时按 openai/claude/ollama 顺序重试有 key 的）
LLM_FALLBACK_ENABLED=true
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-chat

# ── 2. 向量库 Qdrant ──────────────────────────────────────
# 留空 → compose 内 qdrant 容器自动连接；用 Cloud 时填 URL + Key
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=gospel
EMBEDDER=kure

# ── 3. 密钥（上线前必改，勿用占位符）──────────────────────
ADMIN_API_KEY=change-me            # ⚠ 必须改成随机值，否则管理 API 对所有人开放
AUTH_SECRET=                      # python -c "import secrets;print(secrets.token_hex(32))"
ENCRYPTION_KEY=                   # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  # PII 字段加密键，须独立于 AUTH_SECRET
APP_ENV=prod
DOCS_ENABLED=false                # 生产关掉 /docs·/openapi.json

# ── 4. 共置(co-location)内部流量绕行 ──────────────────────
# 同机音乐平台等服务用 FLOW_INTERNAL_TOKEN 免速率限制；两侧设**相同值**
FLOW_INTERNAL_TOKEN=
RATE_LIMIT_INTERNAL_IPS=127.0.0.1,::1

# ── 5. 其它 ──────────────────────────────────────────────
TZ=UTC
UVICORN_WORKERS=2
MAX_UPLOAD_SIZE_MB=100
