{
  "name": "ai-music-frontend",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
"test:contract": "node tests/mureka-ui-contract.test.cjs && node tests/gap013-player.test.cjs && node tests/csp-media-allowlist.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "scan:i18n": "node scripts/scan-hardcoded-i18n.mjs",
    "verify:apk": "node scripts/build-apk.mjs --api=https://api.anistar.studio",
    "check:release": "node scripts/check-release-notes.mjs --strict",
    "lint:a11y": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test:a11y": "tsx tests/a11y-keyboard.test.tsx"
  },
  "dependencies": {
    "next": "^16.3.8",
    "qrcode.react": "^3.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "wavesurfer.js": "^7.12.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "20.14.0",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^26.1.0",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.5.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
