# 全局配置样例：复制为 .env 后填入真实值（参考 app/config.py）。

# —— 基础 ——
# sqlite（默认，不破坏现有部署）
DATABASE_URL=sqlite:///./app.db
# PostgreSQL（音乐独立库，Ref: #72 / #74）—— 切换时：
#   1. 本行改为 postgresql+psycopg://<user>:<pw>@<host>:5432/<db>
#      （驱动 psycopg[binary] 已进 requirements，镜像无需改动）
#   2. SCHEMA_CREATE_ALL 二选一：
#      · =1 → 启动时 create_all 建 schema（空库快速起步；之后别再跑 alembic，二者混用会撞）
#      · =0 → 由 `alembic upgrade head` 建/演进 schema（推荐，可版本管理）
#   3. 回切 sqlite 只需改回本行，代码零改动（方言在 app/db.py 里自动分流）
# DATABASE_URL=postgresql+psycopg://flow_music:<password>@127.0.0.1:5432/flow_music
# ⚠ 时间列（DateTime(timezone=True)）在 sqlite 与 PG 上的读写语义不同：
#   PG 的 timestamptz 存 UTC 但按连接会话时区回读（回读为 aware），sqlite 无真 tz 类型
#   （naive 进出）。因此**跨库比较时间前必须先统一 tz**，否则 PG 上会 TypeError。
#   已知受影响点见 app/billing/service.py 的 _utcnow 注释（后续独立任务修）。
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-please
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 逗号分隔的允许来源。除 Web 前端外，若要让 FLOW APP（Capacitor 打包 / PWA）跨源读取本服务
# （如拉取歌曲详情里的 lyrics_sync 逐字歌词），需把其来源一并列出。Capacitor 打包来源为
# capacitor://localhost(iOS) / http://localhost、https://localhost(Android)；PWA 开发为 4174。
# ⚠ 生产务必替换为真实 HTTPS 域名（如 https://music.example.com），勿保留 localhost。
CORS_ORIGINS=http://localhost:3000,http://localhost:4174,capacitor://localhost,http://localhost,https://localhost

# —— 对象存储 / CDN（S3 兼容，可留空；GAP-019） ——
# 留空 = 优雅降级：播放/下载/FLOW 歌单直接用上游 audio_url（30 天过期，但不报错）。
# 配齐 ENDPOINT+BUCKET+ACCESS_KEY+SECRET_KEY 后自动启用自有 CDN 回源。
STORAGE_ENDPOINT=
STORAGE_REGION=ap-hongkong
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# CDN 加速域名（强烈建议）：播放链接一律经它出口，如 https://cdn.example.com
STORAGE_PUBLIC_BASE=
# 生成完成即回源（新曲首个响应就是 CDN 链接）
ENABLE_CDN_MIRROR_ON_GENERATE=true
# 归档 / 保留（详见 docs/CDN_ARCHIVE_RUNBOOK.md）。
# ⚠ STORAGE_CLASS 与 STORAGE_CLASS_ARCHIVE 都不要填 GLACIER 类（不支持直接 GET 会打断播放）
STORAGE_CLASS=
STORAGE_ARCHIVE_AFTER_DAYS=90
STORAGE_CLASS_ARCHIVE=STANDARD_IA

# —— 音乐供应商（Route A：商业 API） ——
# 当前协议基线：open.suno.cn（国内 SUNO API 平台）。
# 端点 POST /music/generate + GET /music/task?id=，鉴权 Authorization: Bearer <SUNO_API_KEY>。
# 详见 app/orchestrator/suno.py 顶部注释。sunoapi.org / gcui-art 等需按各自文档调整。
MUSIC_PROVIDER=suno
SUNO_API_BASE=https://open.suno.cn/api/v1
SUNO_API_KEY=
SUNO_EMAIL=
SUNO_PASSWORD=
SONG_POLL_INTERVAL=8
SONG_POLL_TIMEOUT=240

# ===== Mureka（昆仑万维）商业 API：christian_worship 主引擎候选 =====
# 官方：https://platform.mureka.ai/ ；基址 https://api.mureka.ai/v1
# 采购档位决定并发：入门(1并发 $200) / 基础(5并发 ¥1万) / 标准(15并发 ¥3万) …
# 将 MUREKA_MAX_CONCURRENT 设为所购档位并发数，避免 429。
MUREKA_API_KEY=
MUREKA_MODEL=mureka-9
MUREKA_N=1
MUREKA_MAX_CONCURRENT=1

# ===== ACE-Step 1.5 私有引擎（本地 GPU 自托管，开源 MIT 可商用）=====
# 默认【关闭】：selection.DEFAULT_ENGINES 中 ace_step_private 的 enabled=False，
# 且 DEFAULT_ROUTING(general/christian_worship/instrumental) 全部指向 mureka。
# 想启用 = 有 GPU 机器并跑起 ACE-Step 服务后，再改下面两项：
#   1) selection.DEFAULT_ENGINES 里 ace_step_private.enabled=True
#   2) DEFAULT_ROUTING 里你想让哪类走它，就把它那条改成 provider="ace_step_private"
# 部署细则见 docs/ACE_STEP_DEPLOYMENT.md（无 GPU / 有 GPU 两条路径）。
#
# ACE_STEP_API_BASE  引擎地址。官方默认 127.0.0.1:8001（api_server.py:2852）。
#                    引擎与本站不同机时改成内网地址，并确认防火墙只放行该端口。
# ACE_STEP_API_KEY   引擎侧 --api-key / ACESTEP_API_KEY。留空 = 引擎免鉴权。
#                    ★ 一旦留空，引擎绝不能对外网暴露，否则任何人都能白嫖你的 GPU。
# ACE_STEP_MODEL     DiT 模型名。turbo 显存需求最低(8GB 档)，base 质量更高但吃显存。
# ACE_STEP_MAX_CONCURRENT  并发上限。本地 GPU 建议 1，否则显存 OOM。
# ACE_STEP_DOWNLOAD_TIMEOUT  音频回源超时（秒）。引擎把音频写本地磁盘，须经
#                    GET /v1/audio?path= 拉回本站对象存储后才能播放。
ACE_STEP_API_BASE=http://127.0.0.1:8001
ACE_STEP_API_KEY=
ACE_STEP_MODEL=acestep-v15-turbo
ACE_STEP_MAX_CONCURRENT=1
ACE_STEP_DOWNLOAD_TIMEOUT=180

# ===== 文案辅助 LLM（创作页 ✨自动优化 / ✨自动生成 / ✨自动取名） =====
# OpenAI 兼容协议。默认指向腾讯混元（hunyuan-lite 免费档，国内合规、数据不出境）。
# 换其他供应商（DeepSeek / Qwen / GLM …）只需改下面三个值，代码零改动。
# ASSIST_LLM_API_KEY 留空 = 辅助按钮自动降级本地确定性规则（永不报错）。
# 腾讯混元：console.cloud.tencent.com/hunyuan 开通后创建 APIKey 填入。
ASSIST_LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
ASSIST_LLM_API_KEY=
ASSIST_LLM_MODEL=hunyuan-lite
ASSIST_LLM_TIMEOUT_SECONDS=20

# —— 限流（MVP 内存实现；多实例生产改 Redis） ——
ENABLE_RATE_LIMIT=true
SYNC_RATE_LIMIT_PER_MINUTE=10

# —— 审核 ——
ENABLE_MODERATION=true
# 音频机审（ASR 转写 → 词库 + 可选云审核）。⚠️ 开启前必须配置 ASR，否则按 fail-closed
# 拦下所有音频走人工（不是放行）—— 这是替换旧「占位恒通过」的核心行为。
ENABLE_AUDIO_MODERATION=false
# 完整合规词库路径（留空 → 用包内 backend/blocklist.txt；该文件缺失 → 内置兜底词库 + 告警）
MODERATION_BLOCKLIST_PATH=

# ============ GAP-016 ASR（音频转写）/ 内容审核 API ============
# ASR 供应商：""（未接，音频机审 fail-closed）| whisper（自建 HTTP 服务）| openai（兼容端点）
ASR_PROVIDER=
# whisper 自建：服务根地址（POST {base}/transcribe）
# openai 兼容：默认 https://api.openai.com/v1（POST {base}/audio/transcriptions）
ASR_API_BASE=
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
ASR_TIMEOUT_SECONDS=60
# 专业内容审核 API（可选）：OpenAI 兼容 /moderations；留空即仅用本地词库
MODERATION_API_BASE=
MODERATION_API_KEY=
MODERATION_API_MODEL=omni-moderation-latest
# 审核失败策略：true=不放行（默认，安全优先）；false=失败放行（不建议）
MODERATION_FAIL_CLOSED=true

# —— 管理后台 ——
# 管理台访问密钥；前端 /admin 页面输入后作为 X-Admin-Token 透传到后端。
# 为空则 admin 路由拒绝所有请求（require_admin 返回错误）。
ADMIN_TOKEN=

# ================= GAP-002 邮箱验证 / 密码重置 / MFA =================
# 邮件发送通道：仅用标准库 smtplib（不引入第三方邮件 SDK）。
# SMTP_HOST 留空 = 开发模式（不实际发送，仅打 warning 日志；链接内容会打到日志里）。
# 生产凭证到位后，只需替换 app/services/email.py 的 send_email() 函数体，其余代码零改动。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS 与 implicit SSL 互斥：587 端口用 STARTTLS=true；465 端口用 USE_SSL=true。
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_FROM=no-reply@flow-music.local
SMTP_TIMEOUT=10
# 生产必须置 true：此时若 SMTP_HOST 未配置，发信端点返回 503（拒绝伪成功），而非静默丢弃。
ENABLE_EMAIL_DELIVERY=false

# 邮件内链接的站点基址（留空则回退 CORS_ORIGINS 第一项）。
FRONTEND_URL=

# token 有效期（分钟）与重发冷却（秒）
EMAIL_VERIFY_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60

# 账户级锁定（与 IP 级限流互补：IP 限流挡不住分布式爆破，账户锁定才是单账户爆破的正解）
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# TOTP 校验窗口：±1 步 = ±30 秒（容忍时钟漂移）
MFA_TOTP_VALID_WINDOW=1

# 认证相关端点 IP 级限流（次/分钟）
VERIFY_RATE_LIMIT_PER_MINUTE=20
RESEND_VERIFICATION_RATE_LIMIT_PER_MINUTE=5
FORGOT_PASSWORD_RATE_LIMIT_PER_MINUTE=5
RESET_PASSWORD_RATE_LIMIT_PER_MINUTE=10
